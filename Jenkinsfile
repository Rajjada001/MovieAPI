pipeline {
    agent any

    stages {
        stage("build") {
            steps {
                echo 'Building the application'
                echo 'Built successfully!'
            }
        }

        stage("test") {
            steps {
                echo 'Testing the application'
            }
        }

        stage("deploy") {
            steps {
                echo 'Deploying the application'
                echo 'Application deployed'
            }
        }
    }
}
